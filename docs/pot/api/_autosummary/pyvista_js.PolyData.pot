msgstr ""

#: ../../src/pyvista_js/mesh.py:docstring of pyvista_js.mesh.PolyData.clip:3
msgid "This filter clips the mesh with a plane defined by a normal vector and an origin point. Points on one side of the plane are removed. It mirrors the PyVista ``clip`` filter API."
msgstr ""

#: ../../src/pyvista_js/mesh.py:docstring of pyvista_js.mesh.PolyData.clip:9
msgid "The clipping is computed in JavaScript at render time by evaluating the signed distance of each vertex from the clip plane. Cells with all vertices on the clipped side are removed. ``vtk.js`` does not include a built-in clipping filter with the exact PyVista API, so this filter is implemented as a custom JavaScript pass."
msgstr ""

#: ../../src/pyvista_js/mesh.py:docstring of pyvista_js.mesh.PolyData.clip:16
msgid "The normal vector of the clipping plane. Can be a string specifying a cardinal direction ('x', 'y', 'z', '-x', '-y', '-z') or a 3-tuple of floats (nx, ny, nz). Default is 'x'."
msgstr ""

#: ../../src/pyvista_js/mesh.py:docstring of pyvista_js.mesh.PolyData.clip:20
msgid "The origin point of the clipping plane as (x, y, z). If not provided, defaults to the center of the mesh's bounding box."
msgstr ""

#: ../../src/pyvista_js/mesh.py:docstring of pyvista_js.mesh.PolyData.clip:23
msgid "If True, flip the clipping direction to keep the part that would normally be removed. Default is False."
msgstr ""

#: ../../src/pyvista_js/mesh.py:docstring of pyvista_js.mesh.PolyData.clip:27
msgid "A new mesh with clipped cells removed."
msgstr ""

