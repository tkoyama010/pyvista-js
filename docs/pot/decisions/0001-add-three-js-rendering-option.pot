msgid "vtk.js dataset type"
msgstr ""

#: ../decisions/0001-add-three-js-rendering-option.md:0
msgid "vtk.js support"
msgstr ""

#: ../decisions/0001-add-three-js-rendering-option.md:0
msgid "three.js counterpart"
msgstr ""

#: ../decisions/0001-add-three-js-rendering-option.md:0
msgid "Impact on the decision"
msgstr ""

#: ../decisions/0001-add-three-js-rendering-option.md:0
msgid "`PolyData`"
msgstr ""

#: ../decisions/0001-add-three-js-rendering-option.md:0
msgid "Class with dedicated mapper"
msgstr ""

#: ../decisions/0001-add-three-js-rendering-option.md:0
msgid "Direct match with `Mesh`, `Points`, `Line`, and `LineSegments`"
msgstr ""

#: ../decisions/0001-add-three-js-rendering-option.md:0
msgid "Fewer concepts to bridge; favors three.js"
msgstr ""

#: ../decisions/0001-add-three-js-rendering-option.md:0
msgid "`ImageData` and volumes"
msgstr ""

#: ../decisions/0001-add-three-js-rendering-option.md:0
msgid "First-class classes with `VolumeMapper`"
msgstr ""

#: ../decisions/0001-add-three-js-rendering-option.md:0
msgid "None; texture- or shader-based translation"
msgstr ""

#: ../decisions/0001-add-three-js-rendering-option.md:0
msgid "Translation cost must be reweighed when support is added"
msgstr ""

