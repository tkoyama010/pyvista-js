#: ../api/_autosummary/pyvista_js.Line.rst:2
msgid "pyvista\\_js.Line"
msgstr "pyvista\\_js.Line"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Line:1
msgid "Create a line segment between two points."
msgstr "2 点間の線分を作成します。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Line:3
msgid ""
"This mirrors the :func:`pyvista.Line` API, producing a polyline of "
"``resolution + 1`` evenly spaced points from ``pointa`` to ``pointb``."
msgstr ""
":func:`pyvista.Line` API と同様に、``pointa`` から ``pointb`` まで ``resolution + 1``"
" 個の等間隔の点からなるポリラインを生成します。"

#: ../api/_autosummary/pyvista_js.Line.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Line:6
msgid "Start point of the line (x, y, z). Default is (0, 0, 0)."
msgstr "線の始点 (x, y, z)。デフォルトは (0, 0, 0) です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Line:8
msgid "End point of the line (x, y, z). Default is (1, 0, 0)."
msgstr "線の終点 (x, y, z)。デフォルトは (1, 0, 0) です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Line:10
msgid ""
"Number of line segments (i.e. ``resolution + 1`` points). Default is 1."
msgstr "線分の数 (つまり ``resolution + 1`` 点)。デフォルトは 1 です。"

#: ../api/_autosummary/pyvista_js.Line.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Line:13
msgid "A line mesh."
msgstr "線のメッシュ。"

#: ../api/_autosummary/pyvista_js.Line.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../api/_autosummary/pyvista_js.Line.rst:0
msgid "Raises"
msgstr "例外"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Line:16
msgid "If ``resolution`` is less than 1."
msgstr "``resolution`` が 1 未満の場合。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Line:19
msgid "Examples"
msgstr "例"
