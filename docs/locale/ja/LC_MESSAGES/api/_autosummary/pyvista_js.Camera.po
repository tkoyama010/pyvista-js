msgstr ":py:obj:`azimuth <pyvista_js.Camera.azimuth>`\\ \\(angle\\)"

#: ../api/_autosummary/pyvista_js.Camera.rst:27:<autosummary>:1
#: ../../src/pyvista_js/camera.pydocstring of
#: pyvista_js.camera.Camera.azimuth:1
msgid "Rotate the camera position horizontally around the focal point."
msgstr "注視点の周囲でカメラ位置を水平方向に回転します。"

#: ../api/_autosummary/pyvista_js.Camera.rst:27:<autosummary>:1
msgid ""
":py:obj:`disable_parallel_projection "
"<pyvista_js.Camera.disable_parallel_projection>`\\ \\(\\)"
msgstr ""
":py:obj:`disable_parallel_projection "
"<pyvista_js.Camera.disable_parallel_projection>`\\ \\(\\)"

#: ../api/_autosummary/pyvista_js.Camera.rst:27:<autosummary>:1
#: ../../src/pyvista_js/camera.pydocstring of
#: pyvista_js.camera.Camera.disable_parallel_projection:1
msgid "Disable parallel projection (use perspective projection)."
msgstr "平行投影を無効にします (透視投影を使用します)。"

#: ../api/_autosummary/pyvista_js.Camera.rst:27:<autosummary>:1
msgid ""
":py:obj:`enable_parallel_projection "
"<pyvista_js.Camera.enable_parallel_projection>`\\ \\(\\)"
msgstr ""
":py:obj:`enable_parallel_projection "
"<pyvista_js.Camera.enable_parallel_projection>`\\ \\(\\)"

#: ../api/_autosummary/pyvista_js.Camera.rst:27:<autosummary>:1
#: ../../src/pyvista_js/camera.pydocstring of
#: pyvista_js.camera.Camera.enable_parallel_projection:1
msgid "Enable parallel (orthographic) projection."
msgstr "平行 (正射影) 投影を有効にします。"

#: ../api/_autosummary/pyvista_js.Camera.rst:27:<autosummary>:1
msgid ":py:obj:`orbit_elevation <pyvista_js.Camera.orbit_elevation>`\\ \\(angle\\)"
msgstr ":py:obj:`orbit_elevation <pyvista_js.Camera.orbit_elevation>`\\ \\(angle\\)"

#: ../api/_autosummary/pyvista_js.Camera.rst:27:<autosummary>:1
#: ../../src/pyvista_js/camera.pydocstring of
#: pyvista_js.camera.Camera.orbit_elevation:1
msgid "Rotate the camera position vertically around the focal point."
msgstr "注視点の周囲でカメラ位置を垂直方向に回転します。"

#: ../api/_autosummary/pyvista_js.Camera.rst:27:<autosummary>:1
msgid ":py:obj:`roll <pyvista_js.Camera.roll>`\\ \\(angle\\)"
msgstr ":py:obj:`roll <pyvista_js.Camera.roll>`\\ \\(angle\\)"

#: ../api/_autosummary/pyvista_js.Camera.rst:27:<autosummary>:1
#: ../../src/pyvista_js/camera.pydocstring of pyvista_js.camera.Camera.roll:1
msgid "Roll the camera around the view direction axis."
msgstr "視線軸の周囲でカメラを回転 (ロール) します。"

#: ../api/_autosummary/pyvista_js.Camera.rst:27:<autosummary>:1
msgid ":py:obj:`zoom <pyvista_js.Camera.zoom>`\\ \\(factor\\)"
msgstr ":py:obj:`zoom <pyvista_js.Camera.zoom>`\\ \\(factor\\)"

#: ../api/_autosummary/pyvista_js.Camera.rst:27:<autosummary>:1
#: ../../src/pyvista_js/camera.pydocstring of pyvista_js.camera.Camera.zoom:1
msgid "Move the camera closer to or farther from the focal point."
msgstr "カメラを注視点に近づけたり遠ざけたりします。"

