#: ../api/_autosummary/pyvista_js.Camera.rst:2
msgid "pyvista\\_js.Camera"
msgstr "pyvista\\_js.Camera"

#: ../../src/pyvista_js/camera.pydocstring of pyvista_js.camera.Camera:1
msgid "Represents a virtual camera in a 3D scene."
msgstr "3D シーンにおける仮想カメラを表します。"

#: ../../src/pyvista_js/camera.pydocstring of pyvista_js.camera.Camera:3
msgid ""
"Provides a PyVista-like API for controlling camera position, orientation, "
"and projection settings in vtk.js scenes."
msgstr "vtk.js シーンでカメラの位置、向き、投影設定を制御するための PyVista 風の API を提供します。"

#: ../api/_autosummary/pyvista_js.Camera.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_js/camera.pydocstring of pyvista_js.camera.Camera:6
msgid "Camera position as (x, y, z). Default is (0, 0, 1)."
msgstr "カメラの位置 (x, y, z)。デフォルトは (0, 0, 1) です。"

#: ../../src/pyvista_js/camera.pydocstring of pyvista_js.camera.Camera:8
msgid "Point the camera looks at as (x, y, z). Default is (0, 0, 0)."
msgstr "カメラの注視点 (x, y, z)。デフォルトは (0, 0, 0) です。"

#: ../../src/pyvista_js/camera.pydocstring of pyvista_js.camera.Camera:10
msgid "View-up vector as (x, y, z). Default is (0, 1, 0)."
msgstr "ビューアップベクトル (x, y, z)。デフォルトは (0, 1, 0) です。"

#: ../../src/pyvista_js/camera.pydocstring of pyvista_js.camera.Camera:12
msgid "Camera view angle (field of view) in degrees. Default is 30.0."
msgstr "カメラの視野角 (field of view) の度数。デフォルトは 30.0 です。"

#: ../../src/pyvista_js/camera.pydocstring of pyvista_js.camera.Camera:14
msgid ""
"Near and far clipping plane distances as (near, far). Default is (0.01, "
"1000.01)."
msgstr "近接・遠方クリッピング平面の距離 (near, far)。デフォルトは (0.01, 1000.01) です。"

#: ../../src/pyvista_js/camera.pydocstring of pyvista_js.camera.Camera:17
msgid ""
"Enable parallel (orthographic) projection instead of perspective projection."
" Default is False."
msgstr "透視投影の代わりに平行 (正射影) 投影を有効にします。デフォルトは False です。"

#: ../../src/pyvista_js/camera.pydocstring of pyvista_js.camera.Camera:20
msgid "Camera elevation angle in degrees. Default is 0.0."
msgstr "カメラの仰角 (度)。デフォルトは 0.0 です。"

