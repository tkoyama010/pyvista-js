#: ../api/_autosummary/pyvista_js.Circle.rst:2
msgid "pyvista\\_js.Circle"
msgstr "pyvista\\_js.Circle"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Circle:1
msgid "Create a circle defined by a set of points in the XY plane."
msgstr "XY 平面内の一連の点で定義される円を作成します。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Circle:3
msgid ""
"This mirrors the :func:`pyvista.Circle` API, producing a closed polygon "
"outline of ``resolution`` points lying in the XY plane."
msgstr ""
":func:`pyvista.Circle` API と同様に、XY 平面内に ``resolution`` "
"個の点からなる閉じたポリゴン輪郭を生成します。"

#: ../api/_autosummary/pyvista_js.Circle.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Circle:6
msgid "Radius of the circle. Default is 0.5."
msgstr "円の半径。デフォルトは 0.5 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Circle:8
msgid "Number of points on the circle. Default is 100."
msgstr "円周上の点の数。デフォルトは 100 です。"

#: ../api/_autosummary/pyvista_js.Circle.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Circle:11
msgid "A circle mesh (closed polyline in the XY plane)."
msgstr "円のメッシュ (XY 平面内の閉じたポリライン)。"

#: ../api/_autosummary/pyvista_js.Circle.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Circle:15
msgid "Examples"
msgstr "例"
