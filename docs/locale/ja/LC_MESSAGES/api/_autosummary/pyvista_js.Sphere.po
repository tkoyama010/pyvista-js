msgid "pyvista\\_js.Sphere"
msgstr "pyvista\\_js.Sphere"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Sphere:1
msgid "Create a sphere mesh."
msgstr "球のメッシュを作成します。"

#: ../api/_autosummary/pyvista_js.Sphere.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Sphere:3
msgid "Sphere radius. Default is 1.0."
msgstr "球の半径。デフォルトは 1.0 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Sphere:5
msgid "Center of the sphere (x, y, z). Default is (0, 0, 0)."
