#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Sphere:7
msgid "Number of points in the azimuthal direction. Default is 30."
msgstr "方位角方向の点の数。デフォルトは 30 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Sphere:9
msgid "Number of points in the polar direction. Default is 30."
msgstr "極方向の点の数。デフォルトは 30 です。"

#: ../api/_autosummary/pyvista_js.Sphere.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Sphere:12
msgid "A sphere mesh."
msgstr "球のメッシュ。"

#: ../api/_autosummary/pyvista_js.Sphere.rst:0
