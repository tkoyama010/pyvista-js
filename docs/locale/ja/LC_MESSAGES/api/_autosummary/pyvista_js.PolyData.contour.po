#: ../api/_autosummary/pyvista_js.PolyData.contour.rst:2
msgid "pyvista\\_js.PolyData.contour"
msgstr ""

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.PolyData.contour:1
msgid "Generate contour lines at constant scalar values."
msgstr ""

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.PolyData.contour:3
msgid ""
"This filter extracts isolines from the mesh at specified scalar values using"
" a marching triangles algorithm implemented in JavaScript. It mirrors the "
"PyVista ``contour`` filter API."
msgstr ""

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.PolyData.contour:9
msgid ""
"The contour is computed in JavaScript at render time by applying the "
"marching triangles algorithm to each triangle of the mesh, interpolating "
"edge crossings at the specified iso-values. ``vtk.js`` does not support "
"``vtkPolyData`` input for ``vtkContourFilter``, so this filter is "
"implemented as a custom JavaScript pass."
msgstr ""

#: ../api/_autosummary/pyvista_js.PolyData.contour.rst:0
msgid "Parameters"
msgstr ""

#: ../../src/pyvista_js/mesh.pydocstring of
#: pyvista_js.mesh.PolyData.contour:16
msgid ""
"Number of evenly spaced contours to generate, or a list of explicit scalar "
"values at which to generate contours. Default is 10."
msgstr ""

#: ../../src/pyvista_js/mesh.pydocstring of
#: pyvista_js.mesh.PolyData.contour:19
msgid ""
"Scalar values per point to use for contouring. If not provided, uses the "
"mesh's existing ``scalars`` attribute. Must have length equal to "
"``n_points``."
msgstr ""

#: ../../src/pyvista_js/mesh.pydocstring of
#: pyvista_js.mesh.PolyData.contour:23
msgid ""
"Name for the scalar array in vtk.js. If not provided, uses the mesh's "
"existing ``scalar_name`` attribute or defaults to \"scalars\"."
msgstr ""

#: ../api/_autosummary/pyvista_js.PolyData.contour.rst:0
msgid "Returns"
msgstr ""

#: ../../src/pyvista_js/mesh.pydocstring of
#: pyvista_js.mesh.PolyData.contour:27
msgid "A new mesh containing the contour lines."
msgstr ""

