#: ../api/_autosummary/pyvista_js.Disc.rst:2
msgid "pyvista\\_js.Disc"
msgstr "pyvista\\_js.Disc"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Disc:1
msgid "Create a disc (annular ring) geometric primitive."
msgstr "円板 (リング状) のジオメトリプリミティブを作成します。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Disc:3
msgid ""
"This mirrors the :func:`pyvista.Disc` API.  The geometry is built directly "
"from ``(r_res + 1)`` rings of ``c_res`` points each, connected as triangles,"
" so it renders correctly in vtk.js without depending on any specific vtk.js "
"source filter."
msgstr ""
":func:`pyvista.Disc` API と同様です。ジオメトリは ``c_res`` 個の点からなる ``(r_res + 1)`` "
"個のリングを三角形として直接構築するため、特定の vtk.js ソースフィルタに依存せずに vtk.js で正しく描画されます。"

#: ../api/_autosummary/pyvista_js.Disc.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Disc:8
msgid "Center of the disc (x, y, z). Default is (0, 0, 0)."
msgstr "円板の中心 (x, y, z)。デフォルトは (0, 0, 0) です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Disc:10
msgid "Inner radius of the disc. Default is 0.25."
msgstr "円板の内半径。デフォルトは 0.25 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Disc:12
msgid "Outer radius of the disc. Default is 0.5."
msgstr "円板の外半径。デフォルトは 0.5 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Disc:14
msgid "Normal vector of the disc. Default is (0, 0, 1)."
msgstr "円板の法線ベクトル。デフォルトは (0, 0, 1) です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Disc:16
msgid "Number of radial subdivisions. Default is 1."
msgstr "半径方向の分割数。デフォルトは 1 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Disc:18
msgid "Number of circumferential subdivisions. Default is 6."
msgstr "円周方向の分割数。デフォルトは 6 です。"

#: ../api/_autosummary/pyvista_js.Disc.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Disc:21
msgid "A disc (annular ring) mesh."
msgstr "円板 (リング状) のメッシュ。"

#: ../api/_autosummary/pyvista_js.Disc.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Disc:25
msgid "Examples"
msgstr "例"
