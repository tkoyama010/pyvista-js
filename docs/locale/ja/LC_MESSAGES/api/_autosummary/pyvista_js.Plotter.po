msgid "String shortcut: 'xy', 'xz', 'yz', 'yx', 'zx', 'zy', or 'iso'"
msgstr "文字列のショートカット: 'xy', 'xz', 'yz', 'yx', 'zx', 'zy', 'iso'"

#: ../../src/pyvista_js/plotter.pydocstring of
#: pyvista_js.plotter.Plotter.show:12
msgid "Direction vector: 3-element tuple/list (x, y, z)"
