#: ../../src/pyvista_js/plotter.pydocstring of
#: pyvista_js.plotter.Plotter.add_points:3
msgid "Point coordinates as an (n, 3) numpy array or PolyData object."
msgstr "(n, 3) の numpy 配列または PolyData オブジェクトとしての点座標。"

#: ../../src/pyvista_js/plotter.pydocstring of
