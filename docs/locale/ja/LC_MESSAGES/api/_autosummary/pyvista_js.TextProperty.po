#: ../api/_autosummary/pyvista_js.TextProperty.rst:2
msgid "pyvista\\_js.TextProperty"
msgstr "pyvista\\_js.TextProperty"

#: ../../src/pyvista_js/text.pydocstring of pyvista_js.text.TextProperty:1
msgid "Properties for text rendering."
msgstr "テキスト描画のプロパティ。"

#: ../../src/pyvista_js/text.pydocstring of pyvista_js.text.TextProperty:3
msgid ""
"Provides control over text appearance including font size, color, and "
"opacity."
msgstr "フォントサイズ、色、不透明度など、テキストの外観を制御します。"

#: ../api/_autosummary/pyvista_js.TextProperty.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_js/text.pydocstring of pyvista_js.text.TextProperty:5
msgid "Font size in points. Default is ``18``."
msgstr "フォントサイズ (ポイント)。デフォルトは ``18`` です。"

#: ../../src/pyvista_js/text.pydocstring of pyvista_js.text.TextProperty:7
msgid ""
"RGB color with values between 0 and 1, or a color name. Default is white."
msgstr "0 から 1 の間の値を持つ RGB カラー、または色名。デフォルトは白です。"

#: ../../src/pyvista_js/text.pydocstring of pyvista_js.text.TextProperty:9
msgid ""
"Text opacity between 0 (transparent) and 1 (opaque). Default is ``1.0``."
msgstr "テキストの不透明度。0 (透明) から 1 (不透明) の間。デフォルトは ``1.0`` です。"

#: ../../src/pyvista_js/text.pydocstring of pyvista_js.text.TextProperty:11
msgid "Enable bold text. Default is ``False``."
msgstr "太字テキストを有効にします。デフォルトは ``False`` です。"

#: ../../src/pyvista_js/text.pydocstring of pyvista_js.text.TextProperty:13
msgid "Enable italic text. Default is ``False``."
msgstr "イタリックテキストを有効にします。デフォルトは ``False`` です。"

#: ../../src/pyvista_js/text.pydocstring of pyvista_js.text.TextProperty:17
msgid "Examples"
msgstr "例"

#: ../api/_autosummary/pyvista_js.TextProperty.rst:16:<autosummary>:1
#: ../../src/pyvista_js/text.pydocstring of
#: pyvista_js.text.TextProperty.__init__:1
msgid "Initialize a TextProperty instance."
msgstr "TextProperty インスタンスを初期化します。"

