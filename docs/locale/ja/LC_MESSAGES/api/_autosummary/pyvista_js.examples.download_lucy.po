msgid "pyvista\\_js.examples.download\\_lucy"
msgstr "pyvista\\_js.examples.download\\_lucy"

#: ../../src/pyvista_js/examples.pydocstring of
#: pyvista_js.examples.download_lucy:1
msgid "Download the Lucy Angel dataset."
msgstr "Lucy Angel データセットをダウンロードします。"

#: ../../src/pyvista_js/examples.pydocstring of
#: pyvista_js.examples.download_lucy:3
msgid ""
"Downloads ``lucy.ply`` from the PyVista vtk-data repository and returns it "
"as a :class:`~pyvista_js.PolyData` mesh, mirroring the "
"``pyvista.examples.download_lucy`` API."
msgstr ""
"PyVista の vtk-data リポジトリから ``lucy.ply`` "
"をダウンロードし、``pyvista.examples.download_lucy`` API と同様に "
":class:`~pyvista_js.PolyData` メッシュとして返します。"

#: ../../src/pyvista_js/examples.pydocstring of
#: pyvista_js.examples.download_lucy:7
msgid ""
"The Lucy Angel is a statue from The Stanford 3D Scanning Repository, "
"decimated to approximately 100k triangles."
msgstr ""
"Lucy Angel は The Stanford 3D Scanning Repository の像で、約 10 万三角形に間引きされています。"

#: ../api/_autosummary/pyvista_js.examples.download_lucy.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_js/examples.pydocstring of
#: pyvista_js.examples.download_lucy:10
