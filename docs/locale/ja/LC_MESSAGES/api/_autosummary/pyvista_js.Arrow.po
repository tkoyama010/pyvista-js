#: ../api/_autosummary/pyvista_js.Arrow.rst:2
msgid "pyvista\\_js.Arrow"
msgstr "pyvista\\_js.Arrow"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:1
msgid "Create an arrow mesh."
msgstr "矢印のメッシュを作成します。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:3
msgid ""
"Returns a :class:`PolyData` representing an arrow starting at ``start`` and "
"pointing in ``direction``, backed by vtk.js ``vtkArrowSource``."
msgstr ""
"``start`` を始点とし ``direction`` を向く、vtk.js の ``vtkArrowSource`` に基づく "
":class:`PolyData` を返します。"

#: ../api/_autosummary/pyvista_js.Arrow.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:6
msgid "Starting point of the arrow ``(x, y, z)``. Default is ``(0, 0, 0)``."
msgstr "矢印の始点 ``(x, y, z)``。デフォルトは ``(0, 0, 0)`` です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:8
msgid "Direction vector of the arrow. Default is ``(1, 0, 0)``."
msgstr "矢印の方向ベクトル。デフォルトは ``(1, 0, 0)`` です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:10
msgid ""
"Length of the conical tip as a fraction of the total arrow length. Default "
"is 0.25."
msgstr "円錐状の先端部分の全長に対する割合。デフォルトは 0.25 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:13
msgid "Radius of the base of the tip. Default is 0.1."
msgstr "先端部分の底面の半径。デフォルトは 0.1 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:15
msgid "Number of faces around the tip cone. Default is 20."
msgstr "先端の円錐周囲の面数。デフォルトは 20 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:17
msgid "Radius of the cylindrical shaft. Default is 0.05."
msgstr "円筒状の軸の半径。デフォルトは 0.05 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:19
msgid "Number of faces around the shaft cylinder. Default is 20."
msgstr "軸の円筒周囲の面数。デフォルトは 20 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:21
msgid ""
"Scaling factor applied to the entire arrow. When ``None`` the arrow is not "
"scaled."
msgstr "矢印全体に適用する倍率。``None`` の場合はスケールしません。"

#: ../api/_autosummary/pyvista_js.Arrow.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:25
msgid "An arrow mesh."
msgstr "矢印のメッシュ。"

#: ../api/_autosummary/pyvista_js.Arrow.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:29
msgid "Examples"
msgstr "例"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:38
msgid "Create an arrow with a custom start point and direction:"
msgstr "カスタムの始点と方向で矢印を作成します:"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Arrow:44
msgid "Plot the arrow:"
msgstr "矢印をプロットします:"
