#: ../api/_autosummary/pyvista_js.Cylinder.rst:2
msgid "pyvista\\_js.Cylinder"
msgstr "pyvista\\_js.Cylinder"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Cylinder:1
msgid "Create a cylinder mesh."
msgstr "円柱のメッシュを作成します。"

#: ../api/_autosummary/pyvista_js.Cylinder.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Cylinder:3
msgid "Center of the cylinder (x, y, z). Default is (0, 0, 0)."
msgstr "円柱の中心 (x, y, z)。デフォルトは (0, 0, 0) です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Cylinder:5
msgid "Direction vector of the cylinder axis. Default is (1, 0, 0)."
msgstr "円柱の軸の方向ベクトル。デフォルトは (1, 0, 0) です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Cylinder:7
msgid "Radius of the cylinder. Default is 0.5."
msgstr "円柱の半径。デフォルトは 0.5 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Cylinder:9
msgid "Height of the cylinder. Default is 1.0."
msgstr "円柱の高さ。デフォルトは 1.0 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Cylinder:11
msgid "Number of points around the cylinder. Default is 100."
msgstr "円柱周囲の点の数。デフォルトは 100 です。"

#: ../api/_autosummary/pyvista_js.Cylinder.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Cylinder:14
msgid "A cylinder mesh."
msgstr "円柱のメッシュ。"

#: ../api/_autosummary/pyvista_js.Cylinder.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Cylinder:18
msgid "Examples"
msgstr "例"
