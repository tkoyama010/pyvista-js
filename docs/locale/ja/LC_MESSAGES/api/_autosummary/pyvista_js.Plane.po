#: ../api/_autosummary/pyvista_js.Plane.rst:2
msgid "pyvista\\_js.Plane"
msgstr "pyvista\\_js.Plane"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Plane:1
msgid "Create a plane mesh."
msgstr "平面のメッシュを作成します。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Plane:3
msgid ""
"This mirrors the :func:`pyvista.Plane` API, producing a flat rectangular "
"mesh oriented according to the given normal ``direction``."
msgstr ""
":func:`pyvista.Plane` API と同様に、指定した法線 ``direction`` "
"に従って向きが決まる平坦な長方形メッシュを生成します。"

#: ../api/_autosummary/pyvista_js.Plane.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Plane:6
msgid "Center of the plane (x, y, z). Default is (0, 0, 0)."
msgstr "平面の中心 (x, y, z)。デフォルトは (0, 0, 0) です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Plane:8
msgid "Normal direction of the plane (x, y, z). Default is (0, 0, 1)."
msgstr "平面の法線方向 (x, y, z)。デフォルトは (0, 0, 1) です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Plane:10
msgid "Size in the i (first) direction. Default is 1.0."
msgstr "i (第一) 方向のサイズ。デフォルトは 1.0 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Plane:12
msgid "Size in the j (second) direction. Default is 1.0."
msgstr "j (第二) 方向のサイズ。デフォルトは 1.0 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Plane:14
msgid "Number of subdivisions in the i direction. Default is 10."
msgstr "i 方向の分割数。デフォルトは 10 です。"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Plane:16
msgid "Number of subdivisions in the j direction. Default is 10."
msgstr "j 方向の分割数。デフォルトは 10 です。"

#: ../api/_autosummary/pyvista_js.Plane.rst:0
msgid "Returns"
msgstr "戻り値"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Plane:19
msgid "A plane mesh."
msgstr "平面のメッシュ。"

#: ../api/_autosummary/pyvista_js.Plane.rst:0
msgid "Return type"
msgstr "戻り値の型"

#: ../../src/pyvista_js/mesh.pydocstring of pyvista_js.mesh.Plane:23
msgid "Examples"
msgstr "例"
