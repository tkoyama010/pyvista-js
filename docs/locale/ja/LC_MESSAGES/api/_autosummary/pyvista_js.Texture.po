#: ../api/_autosummary/pyvista_js.Texture.rst:2
msgid "pyvista\\_js.Texture"
msgstr "pyvista\\_js.Texture"

#: ../../src/pyvista_js/texture.pydocstring of pyvista_js.texture.Texture:1
msgid "Surface texture wrapping an image URL."
msgstr "画像 URL をラップする表面テクスチャ。"

#: ../../src/pyvista_js/texture.pydocstring of pyvista_js.texture.Texture:3
msgid ""
"Mirrors the PyVista :class:`pyvista.Texture` API for browser-based rendering"
" via vtk.js. A texture is applied to a mesh by passing it to "
":meth:`~pyvista_js.Plotter.add_mesh` as the ``texture`` argument."
msgstr ""
"vtk.js によるブラウザ描画のために PyVista の :class:`pyvista.Texture` API "
"と同様の動作をします。テクスチャは ``texture`` 引数として :meth:`~pyvista_js.Plotter.add_mesh` "
"に渡すことでメッシュに適用されます。"

#: ../api/_autosummary/pyvista_js.Texture.rst:0
msgid "Parameters"
msgstr "パラメータ"

#: ../../src/pyvista_js/texture.pydocstring of pyvista_js.texture.Texture:7
msgid "URL of the image to use as a texture (PNG, JPEG, etc.)."
msgstr "テクスチャとして使用する画像の URL (PNG、JPEG など)。"

