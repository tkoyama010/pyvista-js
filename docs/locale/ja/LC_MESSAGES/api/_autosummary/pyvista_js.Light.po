#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:1
msgid "A light source for 3D rendering."
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:3
msgid ""
"Wraps ``vtk.Rendering.Core.vtkLight`` and supports three placement modes:"
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:5
msgid "**SceneLight** - fixed in world space (default)."
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:6
msgid "**CameraLight** - moves with the camera."
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:7
msgid ""
"**Headlight** - always at the camera position, shining toward the focal "
"point."
msgstr ""

#: ../api/_autosummary/pyvista_js.Light.rst:0
msgid "Parameters"
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:9
msgid "(x, y, z) position in world space. Default is ``(0, 0, 1)``."
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:11
msgid "(x, y, z) point the light shines toward. Default is ``(0, 0, 0)``."
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:13
msgid ""
"RGB color with values between 0 and 1, or a color name. Default is white."
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:15
msgid "Brightness of the light. Default is ``1.0``."
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:17
msgid ""
"One of ``'SceneLight'``, ``'CameraLight'``, or ``'Headlight'``. Default is "
"``'SceneLight'``."
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:20
msgid ""
"If ``True``, the light acts as a spotlight using ``cone_angle`` and "
"``cone_falloff``. Default is ``False``."
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:23
msgid ""
"Half-angle (degrees) of the spotlight cone. Values >= 90 disable spot-"
"lighting. Default is ``30.0``."
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:26
msgid ""
"Exponent controlling how sharply the light falls off at the cone edge. "
"Default is ``5.0``."
msgstr ""

#: ../../src/pyvista_js/light.pydocstring of pyvista_js.light.Light:29
msgid ""
"``(constant, linear, quadratic)`` attenuation coefficients. Default is "
"``(1.0, 0.0, 0.0)``."
msgstr ""

