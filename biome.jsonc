{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["ts/**/*.ts", "ts/**/*.d.ts", "biome.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": "error",
      "complexity": "error",
      "correctness": "error",
      "nursery": {
        "noUnsafeTypeAssertion": "off",
        "useConsistentFunctionStyle": "off",
        "noAstroConflictingSetDirectives": "error",
        "noAstroSetHtmlDirective": "error",
        "noBaseToString": "error",
        "noBunModules": "error",
        "noComponentHookFactories": "error",
        "noConditionalExpect": "error",
        "noDrizzleDeleteWithoutWhere": "error",
        "noDrizzleUpdateWithoutWhere": "error",
        "noDuplicateFieldDefinitionNames": "error",
        "noDuplicateSelectors": "error",
        "noEmptyObjectKeys": "error",
        "noExcessiveNestedCallbacks": "error",
        "noExcessiveSelectorClasses": "error",
        "noExtendNative": "error",
        "noFloatingPromises": "error",
        "noIdenticalTestTitle": "error",
        "noImpliedEval": "error",
        "noInlineStyles": "error",
        "noInvalidFileInputAccept": "error",
        "noInvalidPropertyInitValue": "error",
        "noJsRestrictedProperties": "error",
        "noJsonUnsafeValues": "error",
        "noJsxLeakedDollar": "error",
        "noJsxNamespace": "error",
        "noLoopFunc": "error",
        "noMeaninglessVoidOperator": "error",
        "noMisleadingReturnType": "error",
        "noMisplacedListElements": "error",
        "noMisusedPromises": "error",
        "noNegationInEqualityCheck": "error",
        "noNonScalableViewport": "error",
        "noObsoleteTags": "error",
        "noPlaywrightElementHandle": "error",
        "noPlaywrightEval": "error",
        "noPlaywrightForceOption": "error",
        "noPlaywrightMissingAwait": "error",
        "noPlaywrightNetworkidle": "error",
        "noPlaywrightPagePause": "error",
        "noPlaywrightUselessAwait": "error",
        "noPlaywrightWaitForNavigation": "error",
        "noPlaywrightWaitForSelector": "error",
        "noPlaywrightWaitForTimeout": "error",
        "noReactNativeDeepImports": "error",
        "noReactNativeLiteralColors": "error",
        "noReactNativeRawText": "error",
        "noReactObjectTypeAsDefaultProp": "error",
        "noReactStringRefs": "error",
        "noRestrictedDependencies": "error",
        "noReturnInFinally": "error",
        "noSelfImport": "error",
        "noSvelteAtDebugTags": "error",
        "noSvelteAtHtmlTags": "error",
        "noSvelteExportLet": "error",
        "noSvelteLegacyConst": "error",
        "noSvelteUnnecessaryStateWrap": "error",
        "noTailwindArbitraryValue": "error",
        "noTailwindRawColors": "error",
        "noThisOutsideOfClass": "error",
        "noTopLevelLiterals": "error",
        "noUndeclaredClasses": "error",
        "noUndeclaredCustomProperties": "error",
        "noUnmodifiedLoopCondition": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUnsafeIframeSandbox": "error",
        "noUnsafePlusOperands": "error",
        "noUntrustedLicenses": "error",
        "noUnusedClasses": "error",
        "noUselessTypeConversion": "error",
        "noVueDeprecatedScopedSlots": "error",
        "noVueImportCompilerMacros": "error",
        "noVueRefAsOperand": "error",
        "noVueUndeclaredDirectives": "error",
        "noVueVOnNumberValues": "error",
        "noXorAsExponentiation": "error",
        "useArraySome": "error",
        "useAstroClientOnlyDirectiveValue": "error",
        "useAwaitThenable": "error",
        "useBaseline": "error",
        "useBetterDomTraversing": "error",
        "useConsistentObjectKeys": "error",
        "useConsistentTestIt": "error",
        "useControlLabel": "error",
        "useDisposables": "error",
        "useDomNodeTextContent": "error",
        "useDomQuerySelector": "error",
        "useExhaustiveSwitchCases": "error",
        "useExpect": "error",
        "useExplicitReturnType": "error",
        "useExplicitType": "error",
        "useFlatMathMinMax": "error",
        "useIframeSandbox": "error",
        "useImportsFirst": "error",
        "useIncludes": "error",
        "useLayeredStyles": "error",
        "useLogicalProperties": "error",
        "useMathMinMax": "error",
        "useModernMathApis": "error",
        "useNamedCaptureGroup": "error",
        "useNamedLayer": "error",
        "useNullishCoalescing": "error",
        "usePlaywrightValidDescribeCallback": "error",
        "usePromiseRejectErrors": "error",
        "useQwikLoaderLocation": "error",
        "useReactAsyncServerFunction": "error",
        "useReactCompiler": "error",
        "useReactFunctionComponentDefinition": "error",
        "useReactNamingConvention": "error",
        "useReactNativePlatformComponents": "error",
        "useReduceTypeParameter": "error",
        "useRegexpExec": "error",
        "useRegexpTest": "error",
        "useScopedStyles": "error",
        "useSortedClasses": "error",
        "useStrictBooleanExpressions": "error",
        "useStringStartsEndsWith": "error",
        "useSvelteKitRuneImports": "error",
        "useSvelteRequireEachKey": "error",
        "useTailwindShorthandClasses": "error",
        "useTestHooksInOrder": "error",
        "useTestHooksOnTop": "error",
        "useThisInClassMethods": "error",
        "useUnicodeRegex": "error",
        "useValidTestTitle": "error",
        "useVarsOnTop": "error",
        "useVueBaseImport": "error",
        "useVueConsistentDefinePropsDeclaration": "error",
        "useVueNextTickPromise": "error",
        "useVueValidVFor": "error"
      },
      "performance": "error",
      "security": "error",
      "style": "error",
      "suspicious": "error"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
